{
  "name": "microgame-madness",
  "private": true,
  "version": "1.0.0",
  "description": "Browser interface tests for the shared Python game collection",
  "scripts": {
    "build": "python3 scripts/build_web.py",
    "pretest": "npm run build",
    "test": "node --test web/tests/*.test.cjs web/tests/integration/*.test.cjs",
    "test:unit": "node --test web/tests/*.test.cjs",
    "pretest:integration": "npm run build",
    "test:integration": "node --test web/tests/integration/*.test.cjs",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "test:browser:built": "playwright test",
    "test:accounts:hosted": "node --env-file=.env.supabase scripts/verify_hosted_accounts.mjs",
    "accounts:inspect": "node --env-file=.env.supabase scripts/hosted_accounts_admin.mjs inspect",
    "accounts:migrate": "node --env-file=.env.supabase scripts/hosted_accounts_admin.mjs migrate",
    "accounts:deploy": "node --env-file=.env.supabase scripts/hosted_accounts_admin.mjs deploy",
    "test:accounts:hosted:browser": "node --env-file=.env.supabase scripts/verify_hosted_accounts_browser.mjs",
    "test:accounts:hosted:identity": "node --env-file=.env.supabase scripts/verify_hosted_identity.mjs",
    "test:accounts:hosted:pause": "node --env-file=.env.supabase scripts/verify_hosted_pause.mjs",
    "accounts:build-preview": "node --env-file=.env.supabase scripts/build_accounts_preview.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@playwright/test": "1.64.1",
    "pyodide": "0.29.3"
  }
}
